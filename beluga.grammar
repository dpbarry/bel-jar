
//  Precedences

@precedence {
  app    @left
  star   @left
  arrow  @right
  ann    @left
  branch @left
}

//  Top-level

@top Program { Declaration* }

@skip { whitespace | LineComment | BlockComment }

Declaration {
    LFDeclaration
  | LFDatatypeDeclaration
  | SchemaDeclaration
  | InductiveDeclaration
  | StratifiedDeclaration
  | CoinductiveDeclaration
  | TypedefDeclaration
  | RecDeclaration
  | LetDeclaration
  | ProofDeclaration
  | ModuleDeclaration
  | OpenPragma
  | AbbrevPragma
  | NamePragma
  | InfixPragma
  | PrefixPragma
  | AssocPragma
  | NotPragma
  | NoStrengthenPragma
  | OpaquePragma
  | CoveragePragma
  | WarnCoveragePragma
  | QueryPragma
}

//  LF declarations

LFDeclaration {
    LFKeyword (LowerIdentifier | UpperIdentifier) ":" LFKind "."
  | LFKeyword (LowerIdentifier | UpperIdentifier) ":" LFType "."
  | (LowerIdentifier | UpperIdentifier) ":" LFKind "."
  | (LowerIdentifier | UpperIdentifier) ":" LFType "."
}

LFDatatypeDeclaration {
    (LFKeyword | DatatypeKeyword) (LowerIdentifier | UpperIdentifier) (":" LFKind)? "="
    lfConstructorList (AndKeyword (LowerIdentifier | UpperIdentifier) (":" LFKind)? "="
                          lfConstructorList)*
    ";"
}

// The leading `|` is optional and the first constructor may be omitted, matching
// `"=" [con] {"|" con}` in the reference grammar (userguide.tex). Lowercase name
// → inlined, so LFConstructor nodes stay direct children (the formatter relies
// on that).
lfConstructorList { ("|"? LFConstructor ("|" LFConstructor)*)? }

LFConstructor { (LowerIdentifier | UpperIdentifier) ":" LFType }

//  Pragmas

OpenPragma          { "--open" UpperIdentifier "."? }
AbbrevPragma        { "--abbrev" UpperIdentifier UpperIdentifier "."? }
NamePreferred       { UpperIdentifier | LowerIdentifier }
NamePragma          { "--name" LowerIdentifier NamePreferred NamePreferred? "." }
InfixPragma         {
    "--infix" LowerIdentifier Associativity Number "."?
  | "--infix" LowerIdentifier Number Associativity "."?
  | "--infix" LowerIdentifier Number "."?
  | "--infix" LowerIdentifier Associativity "."?
}
PrefixPragma        { "--prefix" LowerIdentifier Number? "."? }
AssocPragma         { "--assoc" Associativity "."? }
NotPragma           { "--not" "."? }
NoStrengthenPragma  { "--nostrengthen" "."? }
OpaquePragma        { "--opaque" LowerIdentifier "."? }
CoveragePragma      { "--coverage" }
WarnCoveragePragma  { "--warncoverage" }

QueryPragma {
    "--query" QueryBound QueryBound QuerySubject "."?
}

QuerySubject {
    UpperIdentifier ":" CompType
}

QueryBound { Number | "*" }

Associativity { NoneKeyword | LeftKeyword | RightKeyword }

//  LF kinds and types

PiBinder { LowerIdentifier | UpperIdentifier }

LFKind {
    TypeKeyword
  | LFType !arrow ArrowOp LFKind
  | "{" PiBinder ":" LFType "}" ArrowOp LFKind
  | "{" PiBinder ":" LFType "}" LFKind
}

LFType {
    LFAppType
    // An index argument may be a lambda term (`[g ⊢ con args \x.M]`); the
    // contextual type/object split is syntactic only, so allow it here too.
  | LFAppType !app LFLambda
  | LFType !arrow ArrowOp LFType
  | "{" PiBinder ":" LFType "}" ArrowOp LFType
  | "{" PiBinder ":" LFType "}" LFType
}

LFAppType {
    LFAtomicType
  | LFAppType !app LFAtomicTerm
}

LFAtomicType {
    LowerIdentifier projection*
  | UpperIdentifier Substitution?
  | ParameterVariable
  | SubstitutionVariable
  | "(" LFType ")"
  | "(" LFType !ann ":" LFType ")"
}

ArrowOp { "->" | "<-" | "←" | "→" }

//  LF terms

LFTerm {
    LFAppTerm
  | LFLambda
  | LFAppTerm !app LFLambda
}

LFLambda { LFLambdaBinder LFTerm }

LFLambdaBinder { "\\" LowerIdentifier "." }

LFAppTerm {
    LFAtomicTerm
  | LFAppTerm !app LFAtomicTerm
}

LFAtomicTerm {
    LowerIdentifier projection* Substitution?
  | UpperIdentifier Substitution?
  | ParameterVariable
  | SubstitutionVariable
  | Tuple
  | Hole
  | UnderscoreHole
  | "(" LFTerm !ann ":" LFType ")"
  | "(" LFTerm ")"
}

// Projections chain (clf_parser.ml): a block field is selected by position
// (`.2`, ProjectionTail) or by name (`.lbl`, NamedProjection — a contextual
// external token, emitted only where a projection can be shifted, so it never
// steals a lambda binder's `.` or a declaration-terminating `.`).
projection { ProjectionTail | NamedProjection }

// Sigma (block) tuple: <M1; M2; ...; Mn>, semicolon-separated (clf_parser.ml).
Tuple           { "<" LFTerm (";" LFTerm)* ">" }
UnderscoreHole  { "_" }

LFBlock {
    BlockKeyword LFBlockField (!app "," LFBlockField)*
  | BlockKeyword "(" LFBlockField ("," LFBlockField)* ")"
}

LFBlockField { LowerIdentifier ":" LFType }

//  Substitutions

Substitution { "[" SubstBody? "]" }

SubstElem { LFTerm }

SubstBody {
    SubstHead ("," SubstElem)*
  | SubstElem ("," SubstElem)*
}

// `..` (or its Unicode ellipsis `…`) is the identity substitution; `^` the empty.
SubstHead { "^" | ".." | "…" }

ParameterVariable {
    "#" LowerIdentifier projection* Substitution?
  | "#" "_"
}

SubstitutionVariable {
    "#" UpperIdentifier Substitution?
  | "$" UpperIdentifier Substitution?
  | "$" LowerIdentifier Substitution?
  | "$" "_"
}

SubstitutionType {
    "$" "[" ContextPart? SubstTurnstile SubstBracketBody "]"
  | "$" "[" SubstTurnstile SubstBracketBody "]"
}

// Inside a substitution type the turnstile may be hashed (`|-#` / `⊢#`),
// marking a renaming substitution (meta_parser.ml).
SubstTurnstile { Turnstile | TurnstileHash }

TurnstileHash { "|-#" | "⊢#" }

SubstBracketBody {
    SubstBody
}

ParameterType {
    "#" "[" ContextPart? Turnstile ParameterTypeBody "]"
  | "#" "[" Turnstile ParameterTypeBody "]"
}

ParameterTypeBody {
    LFType
  | ParameterBlock
}

ParameterBlock {
    BlockKeyword ParameterBlockField ("," ParameterBlockField)*
  | BlockKeyword "(" ParameterBlockField ("," ParameterBlockField)* ")"
}

ParameterBlockField {
    LowerIdentifier ":" ParameterFieldType
}

ParameterFieldType {
    ParameterFieldAppType
  | ParameterFieldType !arrow ArrowOp ParameterFieldType
  | ParameterFieldType !star "*" ParameterFieldType
  | "{" CompTypeBinder "}" ArrowOp ParameterFieldType
  | "(" CompTypeBinder ")" ArrowOp ParameterFieldType
  | "{" CompTypeBinder "}" ParameterFieldType
  | "(" CompTypeBinder ")" ParameterFieldType
}

ParameterFieldAppType {
    ParameterFieldAtom
  | ParameterFieldAppType !app ParameterFieldTypeArg
}

ParameterFieldTypeArg {
    ParameterSubstArg
  | ParameterFieldAtom
  | ContextApplication
}

ParameterFieldAtom {
    ContextualType
  | SubstitutionType
  | ParameterType
  | UpperIdentifier
  | LowerIdentifier
  | TypeKeyword
  | "(" ParameterFieldType ")"
}

//  Schemas

SchemaDeclaration {
    SchemaKeyword LowerIdentifier "=" SchemaBody ";"
}

SchemaBody {
    SchemaElement ("+" SchemaElement)*
}

SchemaElement {
    SchemaSomeBlock (LFBlock | LFType)
  | LFBlock
  | LFType
}

SchemaSomeBlock {
    SomeKeyword "[" SchemaSomeBindings? "]"
}

SchemaSomeBindings {
    (LowerIdentifier | UpperIdentifier) ":" LFType
    ("," (LowerIdentifier | UpperIdentifier) ":" LFType)*
}

//  Inductive, stratified, and coinductive datatypes

InductiveDeclaration {
    InductiveKeyword InductiveBody DatatypeContinuation* ";"
}

StratifiedDeclaration {
    StratifiedKeyword InductiveBody DatatypeContinuation* ";"
}

CoinductiveDeclaration {
    CoinductiveKeyword CoinductiveBody DatatypeContinuation* ";"
}

// A mutual block may mix inductive / stratified / coinductive siblings, each
// reintroducing its flavour keyword after `and` (signature_parser.ml).
DatatypeContinuation {
    AndKeyword InductiveBody
  | AndKeyword InductiveKeyword InductiveBody
  | AndKeyword StratifiedKeyword InductiveBody
  | AndKeyword CoinductiveKeyword CoinductiveBody
}

// Datatype and constructor names use the case-agnostic `identifier` in the
// real parser, so accept lower- or upper-case (the upper-case convention is not
// enforced by the grammar).
InductiveBody {
    datatypeName ":" CompKind "=" "|"? CompConstructor ("|" CompConstructor)*
}

CompConstructor { datatypeName ":" CompType }

// Coinductive (codata): each branch is an observation/destructor whose
// observation type and return type are separated by `::` (signature_parser.ml).
CoinductiveBody {
    datatypeName ":" CompKind "=" "|"? CompDestructor ("|" CompDestructor)*
}

CompDestructor {
    datatypeName ":" CompType "::" CompType
  | "(" datatypeName ":" CompType ")" "::" CompType
}

datatypeName { LowerIdentifier | UpperIdentifier }

CompKind {
    CTypeKeyword
  | PropKeyword
  | CompType !arrow ArrowOp CompKind
  | "{" CompTypeBinder "}" ArrowOp? CompKind
  | "(" CompTypeBinder ")" ArrowOp? CompKind
}

//  Type abbreviations and modules

TypedefDeclaration {
    TypedefKeyword (LowerIdentifier | UpperIdentifier) ":" CompKind "=" CompType ";"
}

ModuleDeclaration {
    ModuleKeyword UpperIdentifier "=" StructKeyword
        Declaration*
    EndKeyword ";"
}

//  Computation-level types

CompType {
    CompAppType
  | CompType !arrow ArrowOp CompType
  | CompType !star "*" CompType
  | "{" CompTypeBinder "}" ArrowOp CompType
  | "(" CompTypeBinder ")" ArrowOp CompType
  | "{" CompTypeBinder "}" CompType
  | "(" CompTypeBinder ")" CompType
}

CompAppType {
    CompAtomicType
  | CompAppType !app CompTypeArg
}

CompTypeArg {
    CompAtomicType
  | ContextApplication
}

CompAtomicType {
    ContextualType
  | SubstitutionType
  | ParameterType
  | UpperIdentifier
  | LowerIdentifier
  | TypeKeyword
  | "(" CompType ")"
}

CompTypeBinder {
    LowerIdentifier ":" CompType
  | UpperIdentifier "::" ContextualType
  | UpperIdentifier ":" CompType
  | ParameterVariable ":" ContextualType
  | ParameterVariable ":" ParameterType
  | SubstitutionVariable ":" ContextualType
  | SubstitutionVariable ":" ParameterType
  | SubstitutionVariable ":" SubstitutionType
}

//  Contextual types and contextual objects


ContextualType {
    "[" ContextPart? Turnstile LFType "]"
}

ContextualObject {
    "[" ContextPart? Turnstile LFTerm "]"
}

Turnstile { "|-" | "⊢" }

ContextPart {
    ContextHead
  | ContextHead "," ContextTailEntry ("," ContextTailEntry)*
  | ContextEntry ("," ContextTailEntry)*
}

ContextHead {
    LowerIdentifier
  | "_"
}

ContextEntry {
    LowerIdentifier ":" LFType
  | LowerIdentifier ":" LFBlock
  | LFBlock
}

ContextTailEntry {
    ContextEntry
  | LowerIdentifier
  | "_"
}

//  Recursive and non-recursive function declarations

RecDeclaration {
    RecKeyword RecBody RecContinuation* ";"
}

RecContinuation {
    AndKeyword RecBody
  | AndKeyword RecKeyword RecBody
}

RecBody {
    LowerIdentifier ":" CompType "=" TotalityAnnotation? Expression
}

TotalityAnnotation {
    "/" TotalKeyword TotalityMeasure "/"
  | "/" TotalKeyword "/"
  | "/" TrustKeyword "/"
}

TotalityMeasure {
    Number
  | LowerIdentifier TotalityCall?
  | UpperIdentifier TotalityCall?
    // Bare parenthesized measure: `/ total (fn args...) /`.
  | TotalityCall
    // Lexicographic order: `{ord1 ord2 ...} (fn args...)`.
  | "{" (LowerIdentifier | UpperIdentifier | Number)+ "}" TotalityCall?
}

TotalityCall {
    "(" TotalityArg (TotalityArg)* ")"
}

TotalityArg {
    LowerIdentifier
  | UpperIdentifier
  | "_"
  | Number
}

LetDeclaration {
    LetKeyword LowerIdentifier (":" CompType)? "=" Expression ";"
}

// Harpoon proof: the header (`proof name : type =`) is parsed precisely so the
// type resolves on hover; the proof script body is consumed opaquely by an
// external tokenizer up to the terminating `;` (signature_parser.ml).
ProofDeclaration {
    ProofKeyword datatypeName ":" CompType "=" ProofScript ";"
}

//  Expressions

Expression {
    AppExpression
  | FnExpression
  | CofunctionExpression
  | MLamExpression
  | CaseExpression
  | LetExpression
  | IfExpression
  | ImpossibleExpression
  | Expression !ann ":" CompType
}

AppExpression {
    AtomicExpression
  | AppExpression !app AtomicExpression
    // Destructor application: `e .obs` eliminates a codata value.
  | AppExpression !app Observation
}

AtomicExpression {
    LowerIdentifier
  | UpperIdentifier
  | ContextualObject
  | SubstitutionType
  | ParameterType
  | TupleOrParenExpression
  | ContextApplication
  | Hole
}

TupleOrParenExpression {
    "(" Expression ("," Expression)* ")"
}

ContextApplication {
    "[" ContextPart? "]"
}

FnExpression {
  FnKeyword FnParam "," FnParam ("," FnParam)* FatArrow Expression
  | FnKeyword FnParam+ FatArrow Expression
}

FnParam { LowerIdentifier | UpperIdentifier | UnderscoreHole }

// `fun` is the cofunction: a copattern-matching abstraction. Each branch is a
// sequence of copatterns — observations (`.d`) and ordinary patterns —
// separated by optional commas, then `=>` body (comp_parser.ml).
CofunctionExpression {
  FunKeyword "|"? CofunctionBranch (!branch "|" CofunctionBranch)*
}

CofunctionBranch {
  QuantifiedBinder* Copattern (","? Copattern)* FatArrow Expression
}

// A copattern is an observation (`.d`) or a pattern. The observation's `.` +
// name is two tokens here (comp-expression context only), so it does not clash
// with LF-level lambda/declaration dots.
Copattern {
    Observation
  | AtomicPattern
}

Observation { "." (LowerIdentifier | UpperIdentifier) }

MLamExpression {
  (MLamKeyword | FNKeyword) MLamParam "," MLamParam ("," MLamParam)* FatArrow Expression
  | (MLamKeyword | FNKeyword) MLamParam+ FatArrow Expression
}

MLamParam {
    UpperIdentifier
  | LowerIdentifier
  | ParameterVariable
  | SubstitutionVariable
}

CaseExpression {
    CaseKeyword Expression OfKeyword CaseBody
}

CaseBody {
    "{" "}"
  | "|"? CaseBranch (!branch "|" CaseBranch)*
}

CaseBranch {
    QuantifiedBinder* Pattern FatArrow Expression
}

FatArrow { "=>" | "⇒" }

QuantifiedBinder {
    "{" CompTypeBinder "}"
}

LetExpression {
    LetKeyword QuantifiedBinder* Pattern "=" Expression InKeyword Expression
}

IfExpression {
    IfKeyword Expression ThenKeyword Expression ElseKeyword Expression
}

ImpossibleExpression {
    ImpossibleKeyword AppExpression
}

//  Patterns

Pattern {
    AppPattern
  | Pattern !ann ":" CompType
}

AppPattern {
    AtomicPattern
  | AppPattern !app AtomicPattern
}

AtomicPattern {
    LowerIdentifier
  | UpperIdentifier
  | ContextualObject
  | ContextApplication
  | SubstitutionType
  | TupleOrParenPattern
  | UnderscoreHole
}

TupleOrParenPattern {
    "(" Pattern ("," Pattern)* ")"
}

// Block comments `%{ ... }%` nest, and documentation comments `%{{ ... }}%`
// behave the same for skipping purposes; an external tokenizer depth-counts the
// `%{` / `}%` delimiters so nested comments are consumed as one (lexer.ml).
@external tokens blockComment from "./beluga-tokens.mjs" { BlockComment }

@external tokens parameterSubst from "./beluga-tokens.mjs" { ParameterSubstArg }
@external tokens proofScript from "./beluga-tokens.mjs" { ProofScript }
@external tokens namedProjection from "./beluga-tokens.mjs" { NamedProjection }

//  Tokens

@tokens {

  whitespace { @whitespace+ }

  LineComment   { "%%" ![\n]* | "%" ![{%\n] ![\n]* | "%" $[\n] }

  // Identifier characters mirror Beluga's lexer (src/parser/lexer.ml): an
  // identifier is any run of characters that are NOT whitespace, control
  // characters, or one of the reserved characters  . , : ; % | " \ ( ) [ ] { }
  // < > and the turnstile glyph (U+22A2). Operators glued to text therefore
  // become part of the identifier (`m/q`, `is_value?`); a standalone operator
  // still wins at a token boundary via @precedence below. Digits, `#`, `$`, `?`
  // cannot START an identifier (they head numbers, parameter/substitution
  // variables, and holes respectively).
  identChar {
    ![\u0000-\u0020\u007F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000.,:;%|"\\(){}\[\]<>\u22A2]
  }

  LowerIdentifier {
    ![\u0000-\u0020\u007F\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000.,:;%|"\\(){}\[\]<>\u22A2A-Z0-9#$?] identChar*
  }
  UpperIdentifier { $[A-Z] identChar* }

  Number { $[0-9]+ }

    ProjectionTail { "." $[0-9]+ }

  // A hole is `?` optionally followed by a name (lexer.ml). The name binds
  // tightly (no whitespace), so the whole thing must be one token.
  Hole { "?" identChar* }

  "->" "<-" "←" "=>" "⇒" "::" ".." "…"
  "(" ")" "[" "]" "{" "}" "<" ">"
  "." "," ":" ";" "|" "*" "+" "=" "_" "^" "#" "$" "/"
  "|-" "|-#" "⊢#"
  "\\"
  "→"
  "⊢"

  "--coverage" "--warncoverage" "--nostrengthen" "--infix" "--prefix"
  "--assoc" "--name" "--abbrev" "--not" "--open" "--query" "--opaque"

  @precedence {
    LineComment,
    "--coverage", "--warncoverage", "--nostrengthen",
    "--infix", "--prefix", "--assoc", "--name",
    "--abbrev", "--not", "--open", "--query", "--opaque",
    "|-#", "⊢#",
    "->", "<-", "←", "=>", "⇒", "::", "..", "…", "|-",
    "→", "⊢",
    ProjectionTail,
    Number,
    Hole,
    "^", "+", "*", "=", "/",
    LowerIdentifier, UpperIdentifier,
    "_",
    "<", ">",
    ".",
    whitespace
  }
}


LFKeyword { @specialize<UpperIdentifier, "LF"> }
FNKeyword { @extend<UpperIdentifier, "FN"> }

TypeKeyword { @specialize<LowerIdentifier, "type"> }
DatatypeKeyword { @extend<LowerIdentifier, "datatype"> }
SchemaKeyword { @specialize<LowerIdentifier, "schema"> }
SomeKeyword { @specialize<LowerIdentifier, "some"> }
BlockKeyword { @specialize<LowerIdentifier, "block"> }
InductiveKeyword { @specialize<LowerIdentifier, "inductive"> }
CTypeKeyword { @specialize<LowerIdentifier, "ctype"> }
PropKeyword { @specialize<LowerIdentifier, "prop"> }
AndKeyword { @specialize<LowerIdentifier, "and"> }
StratifiedKeyword { @specialize<LowerIdentifier, "stratified"> }
TypedefKeyword { @specialize<LowerIdentifier, "typedef"> }
RecKeyword { @specialize<LowerIdentifier, "rec"> }
TotalKeyword { @specialize<LowerIdentifier, "total"> }
FnKeyword { @specialize<LowerIdentifier, "fn"> }
FunKeyword { @specialize<LowerIdentifier, "fun"> }
MLamKeyword { @specialize<LowerIdentifier, "mlam"> }
CaseKeyword { @specialize<LowerIdentifier, "case"> }
OfKeyword { @specialize<LowerIdentifier, "of"> }
LetKeyword { @specialize<LowerIdentifier, "let"> }
InKeyword { @specialize<LowerIdentifier, "in"> }
IfKeyword { @specialize<LowerIdentifier, "if"> }
ThenKeyword { @specialize<LowerIdentifier, "then"> }
ElseKeyword { @specialize<LowerIdentifier, "else"> }
ImpossibleKeyword { @specialize<LowerIdentifier, "impossible"> }
ModuleKeyword { @specialize<LowerIdentifier, "module"> }
StructKeyword { @specialize<LowerIdentifier, "struct"> }
EndKeyword { @specialize<LowerIdentifier, "end"> }
NoneKeyword { @extend<LowerIdentifier, "none"> }
LeftKeyword { @extend<LowerIdentifier, "left"> }
RightKeyword { @extend<LowerIdentifier, "right"> }

TrustKeyword { @specialize<LowerIdentifier, "trust"> }
CoinductiveKeyword { @specialize<LowerIdentifier, "coinductive"> }
ProofKeyword { @specialize<LowerIdentifier, "proof"> }
ByKeyword { @specialize<LowerIdentifier, "by"> }
AsKeyword { @specialize<LowerIdentifier, "as"> }
SufficesKeyword { @specialize<LowerIdentifier, "suffices"> }
ToshowKeyword { @specialize<LowerIdentifier, "toshow"> }

@detectDelim
