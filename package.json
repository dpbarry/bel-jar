{
  "name": "bel-jar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run vendor-fonts && npm run build:editor && npm run build:shell && npm run library:sync-cfgs && npm run library:refresh",
    "library:refresh": "node library/refresh-manifest.mjs",
    "library:sync-cfgs": "node library/sync-cfgs-from-beluga-w.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "build:shell": "node scripts/build-shell.mjs",
    "build:grammar": "lezer-generator beluga.grammar -o js/editor-src/beluga-parser.js",
    "vendor-fonts": "node scripts/vendor-fonts.mjs",
    "lint": "eslint js/",
    "check:build": "node scripts/check-build-stale.mjs",
    "test": "npm run check:build && node tests/run-all.mjs",
    "test:fast": "npm run check:build && node tests/run-all.mjs --fast",
    "test:semantic": "node tests/run-all.mjs semantic",
    "probe": "npm run probe:app && npm run probe:undo && npm run probe:keymap && npm run probe:harpoon && npm run probe:holes",
    "probe:app": "node scripts/probe.mjs",
    "probe:undo": "node scripts/probe-undo.mjs",
    "probe:keymap": "node scripts/probe-keymap.mjs",
    "probe:harpoon": "node scripts/probe-manual-harpoon.mjs",
    "probe:holes": "node scripts/probe-harpoon-panel.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@replit/codemirror-emacs": "^6.1.0",
    "@replit/codemirror-vim": "^6.4.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/generator": "^1.8.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "puppeteer-core": "^25.3.0"
  }
}
