{
  "name": "bel-jar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run vendor-fonts && npm run build:editor && npm run library:sync-cfgs && npm run library:refresh",
    "library:refresh": "node library/refresh-manifest.mjs",
    "library:sync-cfgs": "node library/sync-cfgs-from-beluga-w.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "build:grammar": "lezer-generator beluga.grammar -o editor-src/beluga-parser.js",
    "vendor-fonts": "node scripts/vendor-fonts.mjs",
    "lint": "eslint js/ editor-src/",
    "test": "node tests/run-all.mjs",
    "test:semantic": "node tests/run-all.mjs semantic"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lezer/generator": "^1.8.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0"
  }
}
