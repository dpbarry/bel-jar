%{{{
sample-proof.bel — BelJar editor stress sample

A self-contained STLC development (nat, bool, pairs, functions) with typing,
values, multi-rule reduction, reflexive-transitive closure, and a block of
recursive proof scripts using contexts, case splits, and pattern annotations.

How to use: open in BelJar and scroll through Parts 1–3. Hover identifiers in
signatures, case branches, and LF constructors. This is a realistic proof
development shape, not a checklist written to match any one lint fix.
}}%

% ── Part 1: language ────────────────────────────────────────────────────────

LF sty : type =
  | SNat : sty
  | SBool : sty
  | SProd : sty -> sty -> sty
  | SFn : sty -> sty -> sty
;

LF stm : type =
  | szero : stm
  | ssucc : stm
    -> stm
  | strue : stm
  | sfalse : stm
  | spair : stm -> stm -> stm
  | sfst : stm -> stm
  | ssnd : stm -> stm
  | sift : stm -> stm -> stm -> stm
  | slam : (stm -> stm) -> stm
  | sapp : stm -> stm -> stm
;

LF sval : stm -> type =
  | SV/zero : sval szero
  | SV/succ : sval M -> sval (ssucc M)
  | SV/true : sval strue
  | SV/false : sval sfalse
  | SV/pair : sval M -> sval N -> sval (spair M N)
  | SV/lam : sval (slam (\x. E x))
;

LF styOf : stm -> sty -> type =
  | SO/zero : styOf szero SNat
  | SO/succ : styOf M SNat -> styOf (ssucc M) SNat
  | SO/true : styOf strue SBool
  | SO/false : styOf sfalse SBool
  | SO/pair : styOf M A -> styOf N B -> styOf (spair M N) (SProd A B)
  | SO/fst : styOf M (SProd A B) -> styOf (sfst M) A
  | SO/snd : styOf M (SProd A B) -> styOf (ssnd M) B
  | SO/ift : styOf C SBool -> styOf M1 A -> styOf M2 A -> styOf (sift C M1 M2) A
  | SO/lam : ({x:stm} styOf x A -> styOf (E x) B)
    -> styOf (slam (\x. E x)) (SFn A B)
  | SO/app : styOf F (SFn A B) -> styOf X A -> styOf (sapp F X) B
;

% ── Part 2: operational semantics ───────────────────────────────────────────

LF sstep : stm -> stm -> type =
  | SS/succ : sstep M M' -> sstep (ssucc M) (ssucc M')
  | SS/fst : sstep M M' -> sstep (sfst M) (sfst M')
  | SS/snd : sstep M M' -> sstep (ssnd M) (ssnd M')
  | SS/ift/t : styOf C SBool -> sstep (sift C M1 M2) M1
  | SS/ift/f : styOf C SBool -> sstep (sift C M1 M2) M2
  | SS/beta : sval V -> sstep (sapp (slam (\x. E x)) V) (E V)
;

LF ssteps : stm -> stm -> type =
  | SST/refl : ssteps M M
  | SST/compose : sstep M M' -> ssteps M' N -> ssteps M N
;

schema sctx = block (x:stm);

% ── Part 3: proof scripts ───────────────────────────────────────────────────

rec stlc_id : [⊢ styOf M T] → [⊢ styOf M a T] =
fn d => d;

rec stlc_assume : (hyp : [⊢ styOf M T]) [⊢ styOf M T] → [⊢ styOf M T] =
fn d => d;

rec stlc_ctx : (g:sctx) [g ⊢ styOf x T] → [g ⊢ styOf x T] =
fn d => d;

rec steps_id : (Ψ:sctx)
  (P : [Ψ ⊢ stm])
    (Q : [Ψ ⊢ stm])
      [Ψ ⊢ ssteps P Q]
        → [Ψ ⊢ ssteps P Q] =
fn TracePQ ⇒ case TracePQ of
| [Ψ ⊢ SST/refl] ⇒
  TracePQ
| [Ψ ⊢ SST/compose (leg: sstep Pat N) rest] ⇒
  [Ψ ⊢ SST/compose leg rest];

rec steps_fwd : (Ψ:sctx)
  (P : [Ψ ⊢ stm])
    (Q : [Ψ ⊢ stm])
      [Ψ ⊢ ssteps P Q]
  → [Ψ ⊢ ssteps P Q] =
fn TracePQ ⇒ case TracePQ of
    | [Ψ ⊢ SST/refl] ⇒
      TracePQ
    | [Ψ ⊢ SST/compose stepS rest] ⇒
      [Ψ ⊢ SST/compose stepS rest];

rec step_cases : (Ψ:sctx)
  (P : [Ψ ⊢ stm])
  (Q : [Ψ ⊢ stm])
[Ψ ⊢ sstep P Q]
  → [Ψ ⊢ sstep P Q] =
fn StepPQ ⇒ case StepPQ of
    | [Ψ ⊢ SS/beta V] ⇒
      StepPQ
    | [Ψ ⊢ SS/ift/t TC] ⇒
      StepPQ
    | [Ψ ⊢ SS/ift/f TC] ⇒
      StepPQ
    | [Ψ ⊢ SS/succ S] ⇒
      StepPQ
    | [Ψ ⊢ SS/fst S] ⇒
      StepPQ
    | [Ψ ⊢ SS/snd S] ⇒
      StepPQ;

rec ctx_block : (Ψ:sctx)
[Ψ, xv : stm ⊢ stm]
  → [Ψ, xv : stm ⊢ stm] =
fn t ⇒ t;

rec with_meta : (Ψ:sctx) {MetaS : [⊢ sty]} [Ψ ⊢ stm] → [Ψ ⊢ stm] =
mlam MetaS => fn ParamP => ParamP;

rec use_global : (Ψ:sctx) [Ψ ⊢ stm] → [Ψ ⊢ stm] =
fn t => t;

rec orphan : [⊢ styOf M T] → [⊢ styOf M OrphanTy] → [⊢ styOf M T] =
fn x => fn _ => x;

% Main metatheorem scaffold — case on sstep, fill branches locally
rec preserve : [⊢ styOf M T] → [⊢ sstep M M'] → [⊢ styOf M' T] =
fn tyM => fn stepMM' => case stepMM' of
    | [⊢ SS/beta V] =>
      ?
    | [⊢ SS/ift/t TC] =>
      ?
    | [⊢ SS/ift/f TC] =>
      ?
    | [⊢ SS/succ S] =>
      ?
    | [⊢ SS/fst S] =>
      ?
    | [⊢ SS/snd S] =>
      ?;

% ── Part 4: indexed language + proof scripts (hint-stress corpus) ───────────
% Second development track: modes, indexed terms, multi-step reduction.
% Proofs below are known to pass Beluga; use for hover/case/context coverage.

mode : type.
m/q : mode.
m/u : mode.
≻ : mode → mode → type.
≻/refl : ≻ K K.
tp : mode → type.
𝟙 : {K:mode} tp K.
⊗ : tp K → tp K → tp K.
tm : {K:mode} tp K → type.
pat : {K:mode} tp K → {K':mode} tp K' → type.
match : tm K A → pat K A K' B → tm K' B.
pat/unit : tm K' A → pat K (𝟙 K) K' A.
pat/pair : (tm K A → tm K B → tm K' C) → pat K (⊗ A B) K' C.
neu : tm m/q A → type.
o : type.
nd : o → type.
pf : o → type.
schema ctx = some [K:mode, A:tp K] tm K A;
schema nctx = some [A:tp m/q] block (x:tm m/q A, rx:neu x);
↑ok : ≻ K K' → type.
↦ : tm K A → tm K A → type.
↦* : tm K A → tm K A → type.
↦*/refl : ↦* M M.
↦*/step : ↦ (M : tm K A) (M' : tm K A) → ↦* M' N → ↦* M N.
↦/match/u : neu R → ↦ P P' → ↦ (match R (pat/unit P)) (match R (pat/unit Q)).
↦/match/p : neu R
  → ({x:tm m/q A} neu x → {y:tm m/q B} neu y → ↦ (P x y) (P' x y))
  → ↦ (match R (pat/pair (\x.\y. P x y))) (match R (pat/pair (\x.\y. Q x y))).

rec sec2 : [⊢ pf A] → [⊢ pf B] → [⊢ pf A] =
fn d => fn _ => d;

rec sec3 : (stepBind : [⊢ pf A]) [⊢ pf A] → [⊢ pf A] =
fn d => d;

rec sec3b : (g:ctx) [g ⊢ nd MetaN] → [g ⊢ nd MetaN] =
fn d => d;

rec sec4 : (Ψ:nctx)
  (P : [Ψ ⊢ tm K[] A[]])
  (Q : [Ψ ⊢ tm K[] A[]])
[Ψ ⊢ ↦* P Q]
  → [Ψ ⊢ ↦* P Q] =
fn StepsPQ ⇒ case StepsPQ of
    | [Ψ ⊢ ↦*/refl] ⇒
      StepsPQ
    | [Ψ ⊢ ↦*/step (stepPW: ↦ (PatW: tm K[] A[]) (W: tm K[] A[])) tail] ⇒
      [Ψ ⊢ ↦*/step stepPW tail];

rec sec5a : (Ψ:nctx)
  (P : [Ψ ⊢ tm K[] A[]])
  (Q : [Ψ ⊢ tm K[] A[]])
[Ψ ⊢ ↦* P Q]
  → [Ψ ⊢ ↦* P Q] =
fn StepsPQ ⇒ case StepsPQ of
    | [Ψ ⊢ ↦*/refl] ⇒
      StepsPQ
    | [Ψ ⊢ ↦*/step stepS rest] ⇒
      [Ψ ⊢ ↦*/step stepS rest];

rec sec5 : (Ψ:nctx)
  (P : [Ψ ⊢ tm K[] A[]])
  (Q : [Ψ ⊢ tm K[] A[]])
[Ψ ⊢ ↦ P Q]
  → [Ψ ⊢ ↦ P Q] =
fn StepPQ ⇒ case StepPQ of
    | [Ψ ⊢ ↦/match/u neuR stepU] ⇒
      StepPQ
    | [Ψ ⊢ ↦/match/p X (\x. \nx. \y. \ny. stepP)] ⇒
      StepPQ;

rec sec6 : [⊢ pf A] → [⊢ pf A] =
fn d => d;

rec sec6b : (Ψ:nctx)
[Ψ, xv : tm m/q A[], xnv : neu xv ⊢ tm m/q A[]]
  → [Ψ, xv : tm m/q A[], xnv : neu xv ⊢ tm m/q A[]] =
fn t ⇒ t;

rec sec7 : (Ψ:nctx) {MetaQ : [⊢ o]} [Ψ ⊢ tm m/q A[]] → [Ψ ⊢ tm m/q A[]] =
mlam MetaQ => fn ParamP => ParamP;

rec sec8 : (Ψ:nctx) [Ψ ⊢ tm m/q A[]] → [Ψ ⊢ tm m/q A[]] =
fn t => t;

rec sec9 : [⊢ pf A] → [⊢ pf OrphanM] → [⊢ pf A] =
fn x => fn _ => x;
